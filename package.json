{
  "name": "barberkece",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "db:check": "node tooling/scripts/db-check.mjs",
    "db:generate": "pnpm --filter @barberkece/database db:generate",
    "db:migrate": "pnpm --filter @barberkece/database db:migrate",
    "db:seed": "pnpm --filter @barberkece/database db:seed",
    "db:studio": "pnpm --filter @barberkece/database db:studio",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm --recursive run --if-present test",
    "test:e2e": "pnpm --filter web test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^9.39.5",
    "prettier": "^3.9.6",
    "typescript-eslint": "^8.68.0"
  }
}
